# Speckled Terrazzo — angular stone chips suspended in a polished cement matrix
seed = 127
tile = 1
var matrix_h = 0.10
var matrix_s = 0.10
var matrix_v = 0.72

field chip_id = worley(u, v, freq=17, jitter=1, out=id, seed=3)
field chip_edge = worley(u, v, freq=17, jitter=1, out=edge, seed=3)
field chip_shape = smoothstep(0.050, 0.115, chip_edge)
field chip_gate = step(0.47, chip_id)
field chips = chip_shape*chip_gate
field chip_kind = select(chip_id < 0.64, 0, select(chip_id < 0.82, 1, 2))
field small_chip = spots(u, v, freq=64, prob=0.16, radius=0.17, seed=11)
field matrix_grain = fbm(u, v, freq=74, oct=3, lac=2, gain=0.56, seed=19)
field polish = fbm(u, v, freq=8, oct=3, lac=2, gain=0.52, seed=23)
field chip_hue = select(chip_kind==0, 0.055, select(chip_kind==1, 0.58, 0.94))
field chip_sat = select(chip_kind==0, 0.43, select(chip_kind==1, 0.24, 0.32))
field chip_val = select(chip_kind==0, 0.54, select(chip_kind==1, 0.40, 0.72))

out height = clamp(0.49 + 0.040*chips*(chip_id-0.35) + 0.018*small_chip + 0.012*(matrix_grain-0.5), 0, 1)
out albedo = hsv(lerp(matrix_h, chip_hue, chips), clamp(lerp(matrix_s*(0.85+0.2*polish), chip_sat, chips) + 0.05*small_chip, 0, 1), clamp(lerp(matrix_v*(0.88+0.14*matrix_grain), chip_val*(0.88+0.16*chip_id), chips) - 0.12*small_chip, 0, 1))
out rough = clamp(0.38 + 0.10*matrix_grain + 0.08*small_chip - 0.11*chips - 0.08*polish, 0, 1)
out metal = 0
